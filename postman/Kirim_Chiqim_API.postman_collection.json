{
  "info": {
    "name": "Kirim_Chiqim_API",
    "description": "Kirim-chiqimlarni nazorat qilish loyihasi uchun JWT, kategoriyalar, tranzaksiyalar, valyuta konvertatsiyasi va hisobotlar API sinovlari. So‘rovlarni papkalar tartibida yuboring; tozalash so‘rovlarini yakunda bajaring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autentifikatsiya",
      "item": [
        {
          "name": "1.1 Register — yangi foydalanuvchi",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Oddiy user yaratadi. Qayta ishga tushirganda username avtomatik yangilanadi.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"first_name\": \"Exam\",\n  \"last_name\": \"User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueName = \"exam_user_\" + Date.now();",
                  "pm.collectionVariables.set(\"username\", uniqueName);",
                  "pm.collectionVariables.set(\"email\", uniqueName + \"@example.com\");",
                  "pm.collectionVariables.set(\"password\", \"UzFinance#2026Secure\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Register 201 yoki 200 qaytardi\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 JWT — access va refresh olish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "description": "1.2 JWT — access va refresh olish",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Token olindi\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", data.access);",
                  "pm.collectionVariables.set(\"refresh_token\", data.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 JWT — access tokenni yangilash",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token",
                "refresh"
              ]
            },
            "description": "1.3 JWT — access tokenni yangilash",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Access token yangilandi\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", data.access);",
                  "if (data.refresh) { pm.collectionVariables.set(\"refresh_token\", data.refresh); }"
                ]
              }
            }
          ]
        }
      ]
    },
